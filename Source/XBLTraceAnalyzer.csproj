<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>XboxLiveTrace</RootNamespace>
    <AssemblyName>XboxLiveTraceAnalyzer</AssemblyName>
    <StartupObject>XboxLiveTrace.Program</StartupObject>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Assembly metadata (previously in Properties\AssemblyInfo.cs) -->
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Xbox Live Trace Analyzer</Product>
    <Company>Microsoft Corporation</Company>
    <Copyright>Copyright (c) Microsoft Corporation</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!--
    These resources are loaded at runtime via Assembly.GetManifestResourceStream using
    fixed names. The explicit LogicalName values preserve the exact manifest names the
    code expects (e.g. "XboxLiveTrace.XboxLiveTraceAnalyzer.Rules.json").
  -->
  <ItemGroup>
    <None Remove="XboxLiveTraceAnalyzer.Rules.json" />
    <None Remove="XboxLiveTraceAnalyzer.APIMap.csv" />
    <None Remove="html-report.zip" />
    <EmbeddedResource Include="XboxLiveTraceAnalyzer.Rules.json" LogicalName="XboxLiveTrace.XboxLiveTraceAnalyzer.Rules.json" />
    <EmbeddedResource Include="XboxLiveTraceAnalyzer.APIMap.csv" LogicalName="XboxLiveTrace.XboxLiveTraceAnalyzer.APIMap.csv" />
    <EmbeddedResource Include="html-report.zip" LogicalName="XboxLiveTrace.html-report.zip" />
  </ItemGroup>

  <ItemGroup>
    <None Include="XboxLiveTraceAnalyzer-ReadMe.docx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
